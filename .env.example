# --- Database (Neon) ---
# Pooled connection string (host contains "-pooler"), used at runtime by the app
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
# Direct (non-pooled) connection string, used by `prisma migrate`
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Google Gemini (server-side only) ---
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-3.5-flash-lite"
# Global cap on AI draft generations per UTC day (protects API spend)
DAILY_AI_LIMIT="300"

# --- Admin auth ---
ADMIN_PASSWORD="change-me-to-a-long-password"
# 32+ random chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-32+-random-characters"
# Salt used to hash IPs for rate limiting (defaults to SESSION_SECRET if unset)
IP_HASH_SALT=""

# --- Public site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Business details ---
BUSINESS_NAME="Sunrise Cafe"
BUSINESS_CATEGORY="Cafe"
BUSINESS_CITY="Pune"
GOOGLE_REVIEW_URL="https://search.google.com/local/writereview?placeid=XXXX"
BUSINESS_KEYWORDS="best coffee in Pune,cozy cafe,breakfast"
BUSINESS_STAFF="Priya,Rahul"
BUSINESS_SERVICES="Coffee,Breakfast,Desserts"
BRAND_COLOR="#0f766e"
CONTACT_EMAIL_OR_PHONE="hello@example.com"
# Optional: absolute URL or /public path to a logo image
BUSINESS_LOGO_URL=""
